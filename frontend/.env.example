# Frontend Environment Variables
# Locally use http://localhost:5000 (or leave empty to use Vite dev proxy)
# On Vercel production, set to your Render backend URL e.g. https://cinereward-backend.onrender.com
VITE_API_URL=

# Supabase Auth & Client Configuration (Public Publishable / Anon Key ONLY)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
