# ============================================================================
# CineReward Backend Environment Variables (.env)
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS and OAuth redirects)
# Set this to your Vercel frontend URL e.g. https://cinereward.vercel.app
FRONTEND_URL=https://cinereward.vercel.app

# Supabase PostgreSQL Database (Required)
# Get from Supabase Dashboard -> Project Settings -> Data API / API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# JWT & Express Session Secrets (use strong random 32+ char strings)
JWT_SECRET=
SESSION_SECRET=

# TMDB API Key (Movie Discovery & Catalog)
TMDB_API_KEY=

# Groq AI (AI Comment Classifier & Vibe Tags for Movie Teams)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Google OAuth Login (Passport fallback alongside Supabase OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Service (Resend + Optional Gmail SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CineReward <onboarding@resend.dev>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SMTP_FROM_EMAIL=

# Optional Env-Based Super Admin Login (or add admin row directly in Supabase `users` table)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SECRET_CODE=

# Partner Payment Bank Details
ADMIN_BANK_NAME=
ADMIN_ACCOUNT_NO=
ADMIN_IFSC=
ADMIN_UPI=
