# Server Configuration
PORT=5000
NODE_ENV=production
# Base64-encode the Firebase service-account JSON for deployment.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternatively, provide compact one-line JSON in FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=

# Frontend URL (for CORS and OAuth redirects)
# Set this to your Render frontend URL e.g. https://cinereward.onrender.com
FRONTEND_URL=

# MongoDB Database (MongoDB Atlas)
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=

# TMDB API Key (Movie Data)
TMDB_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Google OAuth Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to /api/auth/google/callback
GOOGLE_CALLBACK_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Service (Gmail SMTP) - used for SMTP connectivity check only
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SMTP_FROM_EMAIL=

# Resend API (actually sends transactional emails, e.g. review reminders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CineReward <onboarding@resend.dev>

# Super Admin Login (used by adminController.superLogin — set strong, unique values)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Partner Payment Bank Details
ADMIN_BANK_NAME=
ADMIN_ACCOUNT_NO=
ADMIN_IFSC=
ADMIN_UPI=

